PORT=3000
DATABASE_PATH=./data/ampersand.sqlite
# Optional on Vercel/Render (platform URLs are used automatically).
# Set this to your custom domain when you add one. No trailing slash.
APP_URL=http://localhost:3000
# Keep enabled for a review deployment; disable for a private pilot.
ENABLE_DEMO=true
# Separate Vercel projects: demo blocks real signups; live blocks sample creation.
# Leave APP_MODE unset to keep the combined local development experience.
# APP_MODE=demo
# On the demo project, link to the live project's public origin (no path):
# LIVE_APP_URL=https://your-live-project.vercel.app
# On the live project, link to the demo project's public origin (no path):
# DEMO_APP_URL=https://your-demo-project.vercel.app
# Vercel: connect Turso in the project's Storage tab to populate these.
# Never add a VITE_ prefix: these are server-only credentials.
# Leave unset for the existing local SQLite database.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
