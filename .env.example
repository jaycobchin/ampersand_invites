PORT=3000
DATABASE_PATH=./data/ampersand.sqlite
# Optional on Vercel/Render (platform URLs are used automatically).
# Set this to your custom domain when you add one. No trailing slash.
APP_URL=http://localhost:3000
# Keep enabled for a review deployment; disable for a private pilot.
ENABLE_DEMO=true
# Vercel: connect Turso in the project's Storage tab to populate these.
# Never add a VITE_ prefix: these are server-only credentials.
# Leave unset for the existing local SQLite database.
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=
